# Maintainer: kvk250 (OLIT Technologies)
# Repackages the GitPilot .deb for Arch Linux / CachyOS / Manjaro / EndeavourOS.
# Build: put GitPilot_<version>_amd64.deb next to this file (LICENSE is included here), then run `makepkg -si`.
pkgname=gitpilot-bin
pkgver=0.4.5
pkgrel=1
pkgdesc="Desktop Git manager: changes, diffs, hunk staging, history, branches, remotes"
arch=('x86_64')
url="https://olittechnologies.co.in"
license=('MIT')
depends=('git' 'webkit2gtk-4.1' 'gtk3' 'libsoup3' 'dbus' 'hicolor-icon-theme' 'polkit')
optdepends=(
  'gnome-keyring: store AI API keys and the GitHub sign-in securely (or kwallet / any Secret Service provider)'
  'kwallet: store AI API keys and the GitHub sign-in securely on KDE'
  'xterm: a terminal for opening Claude Code (any terminal emulator works)'
)
provides=('gitpilot')
conflicts=('gitpilot')
options=('!strip' '!debug')
source=("GitPilot_${pkgver}_amd64.deb" "LICENSE")
sha256sums=('ec4ea4874d56838b72381f46483361cc35d5e1b5b9456dea1281ba2c433cceec'
            'd1c1376cd0a251e9f38eed5a50df9cd4a7193f321be5161bebe166ff2fd7b49d')

package() {
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  bsdtar -xf "${srcdir}/data.tar.gz" -C "${pkgdir}"
  chmod 755 "${pkgdir}/usr/bin/gitpilot"
  # Tells GitPilot it is managed by pacman, so in-app updates install the signed package with pacman.
  install -Dm644 /dev/null "${pkgdir}/usr/share/gitpilot/package-manager"
  echo pacman > "${pkgdir}/usr/share/gitpilot/package-manager"
  # Tauri names this icon size "256x256@2"; hicolor expects "256x256@2x".
  if [[ -d "${pkgdir}/usr/share/icons/hicolor/256x256@2" ]]; then
    mv "${pkgdir}/usr/share/icons/hicolor/256x256@2" "${pkgdir}/usr/share/icons/hicolor/256x256@2x"
  fi
}
