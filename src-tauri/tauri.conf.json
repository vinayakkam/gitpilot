{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitPilot",
  "version": "0.4.5",
  "identifier": "in.co.olittechnologies.gitpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GitPilot",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "nsis",
      "msi"
    ],
    "category": "DeveloperTool",
    "license": "MIT",
    "shortDescription": "Desktop Git manager",
    "longDescription": "GitPilot manages Git repositories: changes, diffs, staging, commits, history, branches and remotes, with optional AI commit messages and Claude Code integration.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../packaging/windows/nsis-header.bmp",
        "sidebarImage": "../packaging/windows/nsis-sidebar.bmp",
        "displayLanguageSelector": false
      },
      "wix": {
        "bannerPath": "../packaging/windows/wix-banner.bmp",
        "dialogImagePath": "../packaging/windows/wix-dialog.bmp"
      }
    },
    "publisher": "OLIT Technologies",
    "copyright": "\u00a9 2026 OLIT Technologies",
    "homepage": "https://github.com/vinayakkam/gitpilot",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2N0NBODk0MzdBRUMwQkUKUldTK3dLNDNsS2g4Tmc3TjVDTlRDZndGWllaNUFSajRQRWp1OHFPdmhRSVNYRVpVSjhwZUJkQkIK",
      "endpoints": [
        "https://github.com/vinayakkam/gitpilot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
